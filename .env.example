# Copy to .env locally and provide real values outside version control.
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=
# Preferred pooled Neon connection for automated database-backed tests against
# the isolated test database. Used by Vitest via scripts/register-env.cjs.
# Never print this value. Automated tests never use ordinary DATABASE_URL.
TEST_DATABASE_URL=
# Optional direct, non-pooler URL for applying migrations to the same database
# used by TEST_DATABASE_URL and for explicit clean-migration validation.
# Never point this at development or production.
TEST_MIGRATION_DATABASE_URL=
# R1-P04 database-backed suites are fail-closed. Set to true only when both
# TEST_DATABASE_URL and TEST_MIGRATION_DATABASE_URL name the same approved
# disposable proof database (canonical: cleanora_r1_p04_clean_proof).
# R1-P02 CI, production-like, Railway, and shared app databases are rejected.
# Never put credentials in this example file.
TEST_DATABASE_HAS_R1_P04=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=info

# R1-P04A authentication requires email delivery for every category.
# SMS providers and phone verification are deferred to a later approved phase.
# All four secrets must contain 32+ characters and be mutually different.
AUTH_ENABLED=true
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=cleanora-api
JWT_AUDIENCE=cleanora-web
AUTH_VERIFIER_SECRET=
AUTH_PRIVACY_HASH_SECRET=
AUTH_REFRESH_COOKIE_NAME=cleanora_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# Local HTTP: false. Railway HTTPS: true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Authentication email delivery. Supply this complete SMTP group only when
# AUTH_ENABLED=true and EMAIL_AUTH_ENABLED=true. Keep credentials local.
EMAIL_AUTH_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Cleanora
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# Must remain false in the current phase. Startup fails closed when set true.
SMS_AUTH_ENABLED=false

# Optional as one complete group when Google sign-in is enabled in R1-P02.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Allowlisted frontend route that completes session bootstrap after OAuth.
GOOGLE_FRONTEND_CALLBACK_URI=http://localhost:5173/auth/google/callback

# Railway production overrides (set these in Railway Variables, not in local .env):
# NODE_ENV=production
# Railway normally injects PORT. If Public Networking has an explicit target
# port (for example 8000), set PORT to exactly that same value.
# CORS_ORIGINS=https://your-frontend.example
# AUTH_COOKIE_SECURE=true
# GOOGLE_REDIRECT_URI=https://your-api.example/api/v1/auth/google/callback
# GOOGLE_FRONTEND_CALLBACK_URI=https://your-frontend.example/auth/google/callback

OWNER_ADMIN_API_ENABLED=false
# Long secret stored outside Git. Required only when OWNER_ADMIN_API_ENABLED=true.
OWNER_ADMIN_SECRET=

# R1-P04 customers/media runtime (optional in base env schema; required when
# customers composition is wired — see customers readiness probe). DEC-033:
# Cloudinary only; do not put real credentials in this example file.
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_IMAGE_FOLDER=cleanora/customer-profile-images
CLOUDINARY_SIGNED_URL_TTL_SECONDS=900
MEDIA_IMAGE_MAX_BYTES=5242880
# Positive integer; no default. Required when customers runtime is composed.
PRIVACY_REQUEST_TERMINAL_RETENTION_DAYS=

# R1-P06 payout protected-data configuration. There are intentionally no
# example, default, or fallback keys. Inject independent versioned key maps as
# strict JSON only in an approved secret store/runtime environment.
PAYOUT_DATA_ENCRYPTION_KEYS_JSON=
PAYOUT_DATA_ENCRYPTION_ACTIVE_KEY_ID=
PAYOUT_LOOKUP_HMAC_KEYS_JSON=
PAYOUT_LOOKUP_HMAC_ACTIVE_KEY_ID=
# Required private verification-evidence malware scanner adapter identifier.
PROVIDER_VERIFICATION_SCANNER_PROVIDER=

SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb
