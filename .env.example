# Copy to .env locally and provide real values outside version control.
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=
# Preferred pooled Neon connection for automated database-backed tests against
# the isolated test database. Used by Vitest via scripts/register-env.cjs.
# Never print this value. Prefer this over CI_DATABASE_URL for test runtime.
TEST_DATABASE_URL=
# Optional clean, empty, non-production database used only by the explicit
# migration/double-seed proof. It is never used by normal startup or npm run ci.
# Direct (non-pooled) Neon endpoint. Never mutated by test env selection.
CI_DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=info

# Authentication is not required for R1-P01 startup. Set the full JWT pair
# only when working on R1-P02; provided secrets must be 32+ characters and differ.
AUTH_ENABLED=true
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=cleanora-api
JWT_AUDIENCE=cleanora-web
AUTH_REFRESH_COOKIE_NAME=cleanora_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Authentication email delivery. Supply this complete SMTP group only when
# AUTH_ENABLED=true and EMAIL_AUTH_ENABLED=true. Keep credentials local.
EMAIL_AUTH_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Cleanora
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# Temporary local-development SMS delivery redirect for phone challenges.
# The recipient is always resolved server-side from the account email (or the
# linked verified Google email). No fixed recipient variable is accepted.
# Forbidden in production; replace with a real SMS adapter before launch.
SMS_AUTH_ENABLED=false
AUTH_DEV_SMS_FALLBACK_TO_EMAIL=true

# Optional as one complete group when Google sign-in is enabled in R1-P02.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Allowlisted frontend route that completes session bootstrap after OAuth.
GOOGLE_FRONTEND_CALLBACK_URI=http://localhost:5173/auth/google/callback

SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb
