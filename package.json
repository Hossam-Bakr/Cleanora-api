{
  "name": "cleanora-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Cleanora modular-monolith backend",
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file=.env --conditions=development --import tsx src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --require ./scripts/register-env.cjs ./node_modules/vitest/vitest.mjs run",
    "test:unit": "node --require ./scripts/register-env.cjs ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node --require ./scripts/register-env.cjs ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node --require ./scripts/register-env.cjs ./node_modules/vitest/vitest.mjs run tests/e2e",
    "test:coverage": "node --require ./scripts/register-env.cjs ./node_modules/vitest/vitest.mjs run --coverage",
    "db:check": "node --env-file=.env --conditions=development --import tsx scripts/check-database.ts",
    "auth:inspect": "node --env-file=.env --conditions=development --import tsx scripts/inspect-auth.ts",
    "email:check": "node --env-file=.env --conditions=development --import tsx scripts/email-check.ts",
    "seed": "node --env-file=.env --conditions=development --import tsx scripts/seed.ts",
    "docs:check": "node --conditions=development --import tsx scripts/docs-check.ts",
    "openapi:validate": "node --conditions=development --import tsx scripts/openapi-validate.ts",
    "postman:generate:auth": "node --conditions=development --import tsx scripts/generate-auth-postman.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "db:validate-clean-migration": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/validate-clean-migration.ts",
    "db:ci-validate": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/ci-db-validate.ts",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run prisma:validate && npm run docs:check && npm run openapi:validate"
  },
  "imports": {
    "#config/*": {
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#core/*": {
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#generated/*": {
      "development": "./src/generated/*.ts",
      "default": "./dist/generated/*.js"
    },
    "#integrations/*": {
      "development": "./src/integrations/*.ts",
      "default": "./dist/integrations/*.js"
    },
    "#modules/*": {
      "development": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    },
    "#routes/*": {
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^7.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.30.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.30.1",
    "prisma": "7.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@prisma/dev": {
      "find-my-way": "9.7.0"
    }
  }
}
