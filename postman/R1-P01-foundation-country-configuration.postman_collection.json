    "name": "Cleanora R1-P01 Foundation & Country Configuration",
    "description": "R1-P01 operational health endpoints, duplicated into explicit Hosted and Local folders. Every request includes a saved Success example.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Hosted",
      "item": [
        {
          "name": "System health",
          "item": [
            {
              "name": "Live",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('returns liveness envelope', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(pm.response.code).to.eql(200);",
                      "  pm.expect(body.success).to.eql(true);",
                      "  pm.expect(body.data.status).to.eql('ok');",
                      "  pm.expect(body.requestId).to.be.a('string');",
                      "  const headerRequestId = pm.response.headers.get('x-request-id');",
                      "  pm.expect(headerRequestId).to.eql(body.requestId);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{hostedUrl}}/system/health/live",
                "description": "Confirms that the API process is alive."
              },
              "response": [
                {
                  "name": "Success",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": "{{hostedUrl}}/system/health/live",
                    "description": "Confirms that the API process is alive."
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "body": "{\n  \"success\": true,\n  \"data\": {\n    \"status\": \"ok\",\n    \"service\": \"cleanora-backend\"\n  },\n  \"requestId\": \"7ebf45ad-7384-41ab-8e74-e864ae048d30\"\n}"
                }
              ]
            },
            {
              "name": "Ready",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('returns readiness envelope', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect([200, 503]).to.include(pm.response.code);",
                      "  pm.expect(body.requestId).to.be.a('string');",
                      "  const headerRequestId = pm.response.headers.get('x-request-id');",
                      "  pm.expect(headerRequestId).to.eql(body.requestId);",
                      "  if (pm.response.code === 200) {",
                      "    pm.expect(body.success).to.eql(true);",
                      "    pm.expect(body.data.status).to.eql('ready');",
                      "  } else {",
                      "    pm.expect(body.error).to.include({ code: 'DEPENDENCY_NOT_READY', statusCode: 503 });",
                      "  }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{hostedUrl}}/system/health/ready",
                "description": "Confirms that required runtime dependencies are ready."
              },
              "response": [
                {
                  "name": "Success",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": "{{hostedUrl}}/system/health/ready",
                    "description": "Confirms that required runtime dependencies are ready."
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
