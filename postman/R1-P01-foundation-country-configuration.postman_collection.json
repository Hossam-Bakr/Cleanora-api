          "name": "System Health",
          "item": [
            {
              "name": "Live",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "pm.test(\"Expected health status\", () => pm.expect([200]).to.include(pm.response.code));",
                      "pm.test('Uses a correlated Cleanora response envelope', () => {",
                      "  pm.expect(body.requestId).to.be.a('string');",
                      "  pm.expect(pm.response.headers.get('x-request-id')).to.eql(body.requestId);",
                      "  if (pm.response.code === 200) {",
                      "    pm.expect(body.success).to.eql(true);",
                      "    pm.expect(body.data.status).to.eql('ok');",
                      "  }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{hostUrl}}/system/health/live",
                "description": "Returns 200 when the live health contract succeeds.",
                "auth": {
                  "type": "noauth"
                }
              },
              "response": [
                {
                  "name": "Success",
                  "originalRequest": {
                    "method": "GET",
