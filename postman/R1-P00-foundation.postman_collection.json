  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{hostUrl}}/system/health/live",
              "host": ["{{hostUrl}}"],
              "path": ["system", "health", "live"]
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{hostUrl}}/system/health/ready",
              "host": ["{{hostUrl}}"],
              "path": ["system", "health", "ready"]
            }
          }
        }
      ]
    }
  ]
