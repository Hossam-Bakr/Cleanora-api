{
  "info": {
    "_postman_id": "a1b0c012-4000-8000-8000-000000000012",
    "name": "Cleanora R1-P12 Browse Marketplace",
    "description": "Guest-capable Browse marketplace under /api/v1/browse. Optional Bearer. Eligible providers come only from getStandardBrowseCandidates. No booking mutation or payment initiation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "hostUrl", "value": "https://YOUR-HOSTED-DOMAIN.example" },
    { "key": "accessToken", "value": "" },
    { "key": "countryCode", "value": "EG" },
    { "key": "countryId", "value": "" },
    { "key": "cityId", "value": "" },
    { "key": "districtId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "locale", "value": "AR" },
    { "key": "startsAt", "value": "2026-09-10T08:00:00.000Z" },
    { "key": "endsAt", "value": "2026-09-10T12:00:00.000Z" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const body = pm.response.json();",
          "pm.test('Uses the Cleanora response envelope', function () {",
          "  pm.expect(body.requestId).to.be.a('string');",
          "  pm.expect(body.success).to.be.a('boolean');",
          "  if (pm.response.code < 400) { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property('data'); }",
          "  else { pm.expect(body.success).to.eql(false); pm.expect(body.error.statusCode).to.eql(pm.response.code); pm.expect(body.error.code).to.be.a('string'); }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Local",
      "item": [
        {
          "name": "List browse services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/services?countryCode={{countryCode}}&locale={{locale}}"
          }
        },
        {
          "name": "Get browse service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/services/{{serviceId}}?countryCode={{countryCode}}&locale={{locale}}"
          }
        },
        {
          "name": "List browse cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/countries/{{countryCode}}/cities"
          }
        },
        {
          "name": "List browse districts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/countries/{{countryCode}}/cities/{{cityId}}/districts"
          }
        },
        {
          "name": "List eligible browse providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/providers?serviceId={{serviceId}}&countryId={{countryId}}&cityId={{cityId}}&startsAt={{startsAt}}&endsAt={{endsAt}}&crewPreference=any&requiredTeamUnits=1&locale={{locale}}"
          }
        },
        {
          "name": "Get eligible browse provider detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/providers/{{providerId}}/teams/{{teamId}}?serviceId={{serviceId}}&countryId={{countryId}}&cityId={{cityId}}&startsAt={{startsAt}}&endsAt={{endsAt}}&crewPreference=any&requiredTeamUnits=1&locale={{locale}}"
          }
        },
        {
          "name": "Validation error - forbidden geo input",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/providers?serviceId={{serviceId}}&countryId={{countryId}}&cityId={{cityId}}&startsAt={{startsAt}}&endsAt={{endsAt}}&crewPreference=any&requiredTeamUnits=1&locale={{locale}}&lat=30.0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects unsupported geo input', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Not found - ineligible provider detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/browse/providers/not-eligible-example/teams/not-eligible-team?serviceId={{serviceId}}&countryId={{countryId}}&cityId={{cityId}}&startsAt={{startsAt}}&endsAt={{endsAt}}&crewPreference=any&requiredTeamUnits=1&locale={{locale}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fails closed for an ineligible detail target', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('BROWSE_PROVIDER_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
