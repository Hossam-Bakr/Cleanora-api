  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  provider           Provider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  incumbentClaim     ProviderPayoutIdentityClaim @relation(fields: [incumbentClaimId], references: [id], onDelete: Restrict)
  history            ProviderPayoutHistory[]

