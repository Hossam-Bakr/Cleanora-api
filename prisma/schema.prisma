generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// R1-P00 is architecture-only. Product models are introduced by their owning phases.

enum ConfigValueKind {
  STRING
  NUMBER
  BOOLEAN
  OBJECT
  ARRAY
}

enum ConfigResolutionPolicy {
  GLOBAL_ONLY
  COUNTRY_OVERRIDE_WITH_GLOBAL_FALLBACK
  COUNTRY_REQUIRED
}

enum AuditActorType {
  USER
  SYSTEM
  UNKNOWN
}

enum AccountCategory {
  INDIVIDUAL
  COMPANY
  ENGINEER
  PROVIDER_OWNER
  WORKER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AuthenticationMethod {
  PASSWORD
  GOOGLE
}

enum SessionCapability {
  FULL
  VERIFICATION_ONLY
}

enum AuthDeliveryChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  CATEGORY_VERIFICATION
  OPTIONAL_INDIVIDUAL_EMAIL_VERIFICATION
  PROVIDER_ADMIN_INVITATION_EMAIL_VERIFICATION
}

enum AuthChallengeStatus {
  PENDING_DELIVERY
  ACTIVE
  CONSUMED
  SUPERSEDED
  EXHAUSTED
  DELIVERY_FAILED
}

enum PasswordResetPurpose {
  PASSWORD_RESET
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET
  REFRESH_REUSE
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  SECURITY_FAILURE
}

enum SocialProvider {
  GOOGLE
}

enum AuthEventOutcome {
  SUCCEEDED
  FAILED
  DENIED
}

enum UserRoleStatus {
  ENABLED
  DISABLED
  REVOKED
}

enum PrivilegedActionOperation {
  ROLE_ASSIGN
  ROLE_REVOKE
  ROLE_ENABLE
  ROLE_DISABLE
  STAFF_SAMPLE_PRIVILEGED_WRITE
  PRIVACY_REQUEST_REASSIGN
}

enum PrivacyRequestPurpose {
  DEACTIVATION
  DELETION
  EXPORT
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PrivacyRequestOutcomeCode {
  REQUEST_FULFILLED
  REQUEST_REJECTED
}

enum PreferredLanguage {
  AR
  EN
}

enum MediaOwnerType {
  CUSTOMER_PROFILE_IMAGE
  PROVIDER_LOGO
  PROVIDER_COVER
  PROVIDER_GALLERY_IMAGE
  PROVIDER_GALLERY_VIDEO
}

enum MediaStorageProvider {
  CLOUDINARY
  S3
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  PENDING_DELETE
  DELETED
  PROCESSING
  FAILED
}

enum ProviderKind {
  INDIVIDUAL_TEAM
  REGISTERED_COMPANY
}

enum ProviderApplicationStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ProviderOperationalStatus {
  INACTIVE
  LIVE
  SUSPENDED
}

enum ProviderStatusDomain {
  APPLICATION
  OPERATIONAL
}

enum ProviderMembershipLevel {
  OWNER
  ADMIN
}

enum ProviderMembershipStatus {
  ACTIVE
  DISABLED
}

enum ProviderInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProviderGalleryKind {
  IMAGE
  VIDEO
}

enum ProviderEmailTemplate {
  APPLICATION_SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
}

enum ProviderEmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Currency {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(3)
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  decimalPlaces Int       @map("decimal_places")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  countries     Country[] @relation("CountryDefaultCurrency")

  @@index([isActive])
  @@map("currencies")
}

model Country {
  id                String          @id @default(cuid())
  code              String          @unique @db.VarChar(2)
  nameEn            String          @map("name_en")
  nameAr            String          @map("name_ar")
  defaultCurrencyId String          @map("default_currency_id")
  defaultLocale     String          @map("default_locale")
  supportedLocales  Json            @map("supported_locales")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  defaultCurrency   Currency          @relation("CountryDefaultCurrency", fields: [defaultCurrencyId], references: [id], onDelete: Restrict)
  countryConfigs    CountryConfig[]
  userAddresses     UserAddress[]
  providerProfiles  ProviderProfile[]

  @@index([isActive])
  @@index([defaultCurrencyId])
  @@map("countries")
}

model AppConfig {
  id               String                 @id @default(cuid())
  key              String                 @unique
  value            Json?
  valueKind        ConfigValueKind        @map("value_kind")
  resolutionPolicy ConfigResolutionPolicy @map("resolution_policy")
  description      String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@map("app_configs")
}

model CountryConfig {
  id        String          @id @default(cuid())
  countryId String          @map("country_id")
  key       String
  value     Json
  valueKind ConfigValueKind @map("value_kind")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, key])
  @@index([key])
  @@map("country_configs")
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  reason     String?
  context    Json?
  requestId  String?        @map("request_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@map("audit_logs")
}

model User {
  id                               String               @id @default(cuid())
  phoneE164                        String?              @unique @map("phone_e164") @db.VarChar(16)
  emailNormalized                  String?              @unique @map("email_normalized") @db.VarChar(320)
  accountCategories                AccountCategory[]    @default([]) @map("account_categories")
  verifiedCategories               AccountCategory[]    @default([]) @map("verified_categories")
  status                           UserStatus           @default(ACTIVE)
  suspendedUntil                   DateTime?            @map("suspended_until")
  statusChangedAt                  DateTime             @default(now()) @map("status_changed_at")
  phoneVerifiedAt                  DateTime?            @map("phone_verified_at")
  emailVerifiedAt                  DateTime?            @map("email_verified_at")
  createdAt                        DateTime             @default(now()) @map("created_at")
  updatedAt                        DateTime             @updatedAt @map("updated_at")
  credential                       UserCredential?
  sessions                         UserSession[]
  otpCodes                         OtpCode[]
  passwordResets                   PasswordResetToken[]
  socialAccounts                   SocialAccount[]
  authEvents                       AuthEvent[]
  userRoles                        UserRole[]
  customerProfile                  CustomerProfile?
  individualProfile                IndividualProfile?
  companyProfile                   CompanyProfile?
  engineerProfile                  EngineerProfile?
  userPreferences                  UserPreferences?
  userAddresses                    UserAddress[]
  privacyRequests                  PrivacyRequest[]
  ownedMediaFiles                  MediaFile[]
  providerApplications             Provider[]                 @relation("ProviderApplicationOwner")
  ownedProviders                   Provider[]                 @relation("ProviderApprovedOwner")
  providerMemberships              ProviderMember[]           @relation("ProviderMemberUser")
  providerMemberInvitesSent        ProviderMember[]           @relation("ProviderMemberInviter")
  providerStatusHistoryActions     ProviderStatusHistory[]    @relation("ProviderStatusHistoryActor")
  providerAdminInvitationsSent     ProviderAdminInvitation[]  @relation("ProviderAdminInvitationInviter")
  providerAdminInvitationsAccepted ProviderAdminInvitation[]  @relation("ProviderAdminInvitationAccepter")
  providerGalleryItemsCreated      ProviderGalleryItem[]      @relation("ProviderGalleryItemCreator")
  providerEmailOutboxRecipients    ProviderEmailOutbox[]      @relation("ProviderEmailOutboxRecipient")

  @@index([status])
  @@map("users")
}

model UserCredential {
  id                     String    @id @default(cuid())
  userId                 String    @unique @map("user_id")
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  passwordHashVersion    Int       @default(1) @map("password_hash_version")
  credentialVersion      Int       @default(1) @map("credential_version")
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failureWindowStartedAt DateTime? @map("failure_window_started_at")
  lockedUntil            DateTime? @map("locked_until")
  lastFailedAt           DateTime? @map("last_failed_at")
  lastAuthenticatedAt    DateTime? @map("last_authenticated_at")
  passwordChangedAt      DateTime  @default(now()) @map("password_changed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model UserSession {
  id                     String                   @id @default(cuid())
  userId                 String                   @map("user_id")
  currentRefreshVerifier String                   @unique @map("current_refresh_verifier") @db.Char(64)
  verifierKeyVersion     Int                      @default(1) @map("verifier_key_version")
  rotationCounter        Int                      @default(0) @map("rotation_counter")
  credentialVersion      Int                      @map("credential_version")
  authenticationMethod   AuthenticationMethod     @map("authentication_method")
  capability             SessionCapability
  expiresAt              DateTime                 @map("expires_at")
  lastUsedAt             DateTime?                @map("last_used_at")
  revokedAt              DateTime?                @map("revoked_at")
  revocationReason       SessionRevocationReason? @map("revocation_reason")
  compromisedAt          DateTime?                @map("compromised_at")
  ipHash                 String?                  @map("ip_hash") @db.Char(64)
  userAgentHash          String?                  @map("user_agent_hash") @db.Char(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model OtpCode {
  id                 String              @id @default(cuid())
  userId             String              @map("user_id")
  accountCategory    AccountCategory?    @map("account_category")
  purpose            OtpPurpose
  channel            AuthDeliveryChannel
  destinationHash    String              @map("destination_hash") @db.Char(64)
  codeVerifier       String              @map("code_verifier") @db.Char(64)
  verifierKeyVersion Int                 @default(1) @map("verifier_key_version")
  status             AuthChallengeStatus @default(PENDING_DELIVERY)
  attemptCount       Int                 @default(0) @map("attempt_count")
  maxAttempts        Int                 @default(5) @map("max_attempts")
  resendAvailableAt  DateTime            @map("resend_available_at")
  expiresAt          DateTime            @map("expires_at")
  deliveredAt        DateTime?           @map("delivered_at")
  deliveryFailedAt   DateTime?           @map("delivery_failed_at")
  lastAttemptAt      DateTime?           @map("last_attempt_at")
  consumedAt         DateTime?           @map("consumed_at")
  supersededAt       DateTime?           @map("superseded_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([userId, purpose, accountCategory, status])
  @@index([status, expiresAt])
  @@map("otp_codes")
}

model PasswordResetToken {
  id                 String               @id @default(cuid())
  userId             String               @map("user_id")
  purpose            PasswordResetPurpose @default(PASSWORD_RESET)
  channel            AuthDeliveryChannel
  destinationHash    String               @map("destination_hash") @db.Char(64)
  tokenVerifier      String               @unique @map("token_verifier") @db.Char(64)
  verifierKeyVersion Int                  @default(1) @map("verifier_key_version")
  status             AuthChallengeStatus  @default(PENDING_DELIVERY)
  attemptCount       Int                  @default(0) @map("attempt_count")
  maxAttempts        Int                  @default(5) @map("max_attempts")
  resendAvailableAt  DateTime             @map("resend_available_at")
  expiresAt          DateTime             @map("expires_at")
  deliveredAt        DateTime?            @map("delivered_at")
  deliveryFailedAt   DateTime?            @map("delivery_failed_at")
  lastAttemptAt      DateTime?            @map("last_attempt_at")
  consumedAt         DateTime?            @map("consumed_at")
  supersededAt       DateTime?            @map("superseded_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("password_reset_tokens")
}

model SocialAccount {
  id                      String          @id @default(cuid())
  userId                  String          @map("user_id")
  provider                SocialProvider
  accountCategory         AccountCategory @map("account_category")
  providerSubject         String          @map("provider_subject") @db.VarChar(255)
  providerEmailNormalized String?         @map("provider_email_normalized") @db.VarChar(320)
  providerEmailVerifiedAt DateTime?       @map("provider_email_verified_at")
  providerDisplayName     String?         @map("provider_display_name") @db.VarChar(200)
  providerAvatarUrl       String?         @map("provider_avatar_url") @db.VarChar(2048)
  linkedAt                DateTime        @default(now()) @map("linked_at")
  lastAuthenticatedAt     DateTime?       @map("last_authenticated_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  user                    User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider, accountCategory])
  @@index([userId])
  @@map("social_accounts")
}

model AuthEvent {
  id             String           @id @default(cuid())
  userId         String?          @map("user_id")
  sessionId      String?          @map("session_id")
  eventType      String           @map("event_type") @db.VarChar(64)
  outcome        AuthEventOutcome
  reasonCode     String?          @map("reason_code") @db.VarChar(64)
  requestId      String?          @map("request_id")
  identifierHash String?          @map("identifier_hash") @db.Char(64)
  ipHash         String?          @map("ip_hash") @db.Char(64)
  userAgentHash  String?          @map("user_agent_hash") @db.Char(64)
  context        Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([sessionId])
  @@map("auth_events")
}

// R1-P03 authorization definitions. Identity owns these five tables.
// Role and permission definitions have no activation flag; only user_roles.status
// and privileged_action_reasons.is_active carry lifecycle state.

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  roleId     String         @map("role_id")
  status     UserRoleStatus
  assignedAt DateTime       @default(now()) @map("assigned_at")
  enabledAt  DateTime?      @map("enabled_at")
  disabledAt DateTime?      @map("disabled_at")
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId])
  @@map("user_roles")
}

model PrivilegedActionReason {
  id        String                    @id @default(cuid())
  code      String                    @unique
  name      String
  operation PrivilegedActionOperation @unique
  isActive  Boolean                   @default(true) @map("is_active")
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("privileged_action_reasons")
}

// R1-P04 customer profiles, preferences, text addresses, and privacy requests.
// customers owns business tables; media owns media_files.

model CustomerProfile {
  id                      String     @id @default(cuid())
  userId                  String     @unique @map("user_id")
  profileImageMediaFileId String?    @unique @map("profile_image_media_file_id")
  imageAssociationVersion Int        @default(1) @map("image_association_version")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  user                    User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  profileImageMediaFile   MediaFile? @relation(fields: [profileImageMediaFileId], references: [id], onDelete: SetNull)

  @@map("customer_profiles")
}

model IndividualProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("individual_profiles")
}

model CompanyProfile {
  id                           String   @id @default(cuid())
  userId                       String   @unique @map("user_id")
  companyName                  String   @map("company_name")
  representativeFullName       String   @map("representative_full_name")
  commercialRegistrationNumber String?  @map("commercial_registration_number") @db.VarChar(100)
  taxRegistrationNumber        String?  @map("tax_registration_number") @db.VarChar(100)
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  user                         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("company_profiles")
}

model EngineerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  fullName          String   @map("full_name")
  professionalTitle String   @map("professional_title")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("engineer_profiles")
}

model UserPreferences {
  id              String             @id @default(cuid())
  userId          String             @unique @map("user_id")
  language        PreferredLanguage?
  remindersSms    Boolean            @default(false) @map("reminders_sms")
  remindersPush   Boolean            @default(false) @map("reminders_push")
  promotionalSms  Boolean            @default(false) @map("promotional_sms")
  promotionalPush Boolean            @default(false) @map("promotional_push")
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  countryId   String   @map("country_id")
  city        String
  district    String
  addressText String   @map("address_text")
  building    String?
  floor       String?
  notes       String?
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_addresses")
}

model PrivacyRequest {
  id           String                     @id @default(cuid())
  userId       String                     @map("user_id")
  purpose      PrivacyRequestPurpose
  status       PrivacyRequestStatus
  processorId  String?                    @map("processor_id")
  outcomeCode  PrivacyRequestOutcomeCode? @map("outcome_code")
  requestedAt  DateTime                   @default(now()) @map("requested_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  cancelledAt  DateTime?                  @map("cancelled_at")
  processingAt DateTime?                  @map("processing_at")
  terminalAt   DateTime?                  @map("terminal_at")
  purgeAfter   DateTime?                  @map("purge_after")
  user         User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, status])
  @@index([purgeAfter])
  @@map("privacy_requests")
}

model MediaFile {
  id                   String               @id @default(cuid())
  ownerUserId          String               @map("owner_user_id")
  ownerType            MediaOwnerType       @map("owner_type")
  storageProvider      MediaStorageProvider @map("storage_provider")
  storageKey           String               @map("storage_key")
  contentType          String               @map("content_type")
  byteSize             Int                  @map("byte_size")
  width                Int?
  height               Int?
  status               MediaStatus
  cleanupEligibleAt    DateTime?            @map("cleanup_eligible_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  ownerUser            User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  customerProfileImage CustomerProfile?
  providerLogoProfile  ProviderProfile?     @relation("ProviderProfileLogo")
  providerCoverProfile ProviderProfile?     @relation("ProviderProfileCover")
  providerGalleryItem  ProviderGalleryItem? @relation("ProviderGalleryMedia")

  @@index([ownerUserId, ownerType])
  @@index([status, cleanupEligibleAt])
  @@map("media_files")
}

// R1-P05 provider onboarding, profile, membership, invitation, gallery, and outbox.
// providers owns these tables; authentication/media/configuration keep opposite relations only.

model Provider {
  id                     String                     @id @default(cuid())
  applicationOwnerUserId String                     @unique @map("application_owner_user_id")
  ownerUserId            String?                    @unique @map("owner_user_id")
  kind                   ProviderKind
  applicationStatus      ProviderApplicationStatus  @default(DRAFT) @map("application_status")
  operationalStatus      ProviderOperationalStatus  @default(INACTIVE) @map("operational_status")
  reviewCycle            Int                        @default(0) @map("review_cycle")
  version                Int                        @default(1)
  firstSubmittedAt       DateTime?                  @map("first_submitted_at")
  lastSubmittedAt        DateTime?                  @map("last_submitted_at")
  applicationChangedAt   DateTime                   @default(now()) @map("application_changed_at")
  operationalChangedAt   DateTime                   @default(now()) @map("operational_changed_at")
  approvedAt             DateTime?                  @map("approved_at")
  rejectedAt             DateTime?                  @map("rejected_at")
  suspendedAt            DateTime?                  @map("suspended_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  applicationOwner       User                       @relation("ProviderApplicationOwner", fields: [applicationOwnerUserId], references: [id], onDelete: Restrict)
  owner                  User?                      @relation("ProviderApprovedOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  profile                ProviderProfile?
  contact                ProviderContact?
  statusHistory          ProviderStatusHistory[]
  members                ProviderMember[]
  adminInvitations       ProviderAdminInvitation[]
  galleryItems           ProviderGalleryItem[]
  emailOutbox            ProviderEmailOutbox[]

  @@index([applicationStatus, kind, lastSubmittedAt, id])
  @@index([operationalStatus, id])
  @@map("providers")
}

model ProviderProfile {
  id                String     @id @default(cuid())
  providerId        String     @unique @map("provider_id")
  displayNameAr     String?    @map("display_name_ar") @db.VarChar(200)
  displayNameEn     String?    @map("display_name_en") @db.VarChar(200)
  descriptionAr     String?    @map("description_ar") @db.VarChar(4000)
  descriptionEn     String?    @map("description_en") @db.VarChar(4000)
  countryId         String?    @map("country_id")
  logoMediaFileId   String?    @unique @map("logo_media_file_id")
  coverMediaFileId  String?    @unique @map("cover_media_file_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  provider          Provider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  country           Country?   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  logoMediaFile     MediaFile? @relation("ProviderProfileLogo", fields: [logoMediaFileId], references: [id], onDelete: Restrict)
  coverMediaFile    MediaFile? @relation("ProviderProfileCover", fields: [coverMediaFileId], references: [id], onDelete: Restrict)

  @@map("provider_profiles")
}

model ProviderContact {
  id                         String   @id @default(cuid())
  providerId                 String   @unique @map("provider_id")
  operationalEmailNormalized String?  @map("operational_email_normalized") @db.VarChar(320)
  operationalPhoneE164       String?  @map("operational_phone_e164") @db.VarChar(16)
  channels                   Json     @default("[]")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  provider                   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@map("provider_contacts")
}

model ProviderStatusHistory {
  id                     String                      @id @default(cuid())
  providerId             String                      @map("provider_id")
  domain                 ProviderStatusDomain
  fromApplicationStatus  ProviderApplicationStatus?  @map("from_application_status")
  toApplicationStatus    ProviderApplicationStatus?  @map("to_application_status")
  fromOperationalStatus  ProviderOperationalStatus?  @map("from_operational_status")
  toOperationalStatus    ProviderOperationalStatus?  @map("to_operational_status")
  reviewCycle            Int?                        @map("review_cycle")
  actorUserId            String                      @map("actor_user_id")
  reason                 String?                     @db.VarChar(2000)
  requestId              String?                     @map("request_id")
  createdAt              DateTime                    @default(now()) @map("created_at")
  provider               Provider                    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  actorUser              User                        @relation("ProviderStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  emailOutboxRows        ProviderEmailOutbox[]

  @@index([providerId, createdAt])
  @@map("provider_status_history")
}

model ProviderMember {
  id              String                    @id @default(cuid())
  providerId      String                    @map("provider_id")
  userId          String                    @map("user_id")
  level           ProviderMembershipLevel
  status          ProviderMembershipStatus
  invitedByUserId String?                   @map("invited_by_user_id")
  enabledAt       DateTime                  @map("enabled_at")
  disabledAt      DateTime?                 @map("disabled_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  provider        Provider                  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user            User                      @relation("ProviderMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedByUser   User?                     @relation("ProviderMemberInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([providerId, userId])
  @@index([userId, status])
  @@index([providerId, level, status])
  @@map("provider_members")
}

model ProviderAdminInvitation {
  id                       String                   @id @default(cuid())
  providerId               String                   @map("provider_id")
  emailNormalized          String                   @map("email_normalized") @db.VarChar(320)
  tokenVerifier            String                   @unique @map("token_verifier") @db.Char(64)
  tokenVersion             Int                      @map("token_version")
  status                   ProviderInvitationStatus @default(PENDING)
  version                  Int                      @default(1)
  invitedByUserId          String                   @map("invited_by_user_id")
  acceptedByUserId         String?                  @map("accepted_by_user_id")
  expiresAt                DateTime                 @map("expires_at")
  sentAt                   DateTime?                @map("sent_at")
  deliveryFailedAt         DateTime?                @map("delivery_failed_at")
  lastSafeDeliveryErrorCode String?                 @map("last_safe_delivery_error_code") @db.VarChar(100)
  acceptedAt               DateTime?                @map("accepted_at")
  revokedAt                DateTime?                @map("revoked_at")
  expiredAt                DateTime?                @map("expired_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  provider                 Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invitedByUser            User                     @relation("ProviderAdminInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUser           User?                    @relation("ProviderAdminInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([providerId, status, createdAt])
  @@index([status, expiresAt])
  @@map("provider_admin_invitations")
}

model ProviderGalleryItem {
  id              String              @id @default(cuid())
  providerId      String              @map("provider_id")
  mediaFileId     String              @unique @map("media_file_id")
  kind            ProviderGalleryKind
  position        Int
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  provider        Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  mediaFile       MediaFile           @relation("ProviderGalleryMedia", fields: [mediaFileId], references: [id], onDelete: Restrict)
  createdByUser   User                @relation("ProviderGalleryItemCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([providerId, position])
  @@map("provider_gallery_items")
}

model ProviderEmailOutbox {
  id               String                     @id @default(cuid())
  providerId       String                     @map("provider_id")
  template         ProviderEmailTemplate
  status           ProviderEmailOutboxStatus  @default(PENDING)
  recipientUserId  String                     @map("recipient_user_id")
  reviewCycle      Int?                       @map("review_cycle")
  statusHistoryId  String?                    @map("status_history_id")
  idempotencyKey   String                     @unique @map("idempotency_key") @db.VarChar(200)
  attemptCount     Int                        @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?                  @map("next_attempt_at")
  lockedUntil      DateTime?                  @map("locked_until")
  sentAt           DateTime?                  @map("sent_at")
  lastSafeErrorCode String?                   @map("last_safe_error_code") @db.VarChar(100)
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  provider         Provider                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  recipientUser    User                       @relation("ProviderEmailOutboxRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  statusHistory    ProviderStatusHistory?     @relation(fields: [statusHistoryId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, lockedUntil])
  @@map("provider_email_outbox")
}
