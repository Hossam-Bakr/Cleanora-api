  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  provider               Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  destinationVersion     ProviderPayoutDestinationVersion @relation(fields: [destinationVersionId], references: [id], onDelete: Restrict)

  @@map("provider_primary_payout_destinations")
}

model ProviderPayoutConflict {
