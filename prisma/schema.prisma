  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  serviceField   ServiceField @relation(fields: [serviceFieldId], references: [id], onDelete: Restrict)

  @@unique([serviceFieldId, value])
  @@unique([serviceFieldId, displayOrder])
  @@map("service_field_options")
}

model ServiceCountryAvailability {
  id          String   @id @default(cuid())
  serviceId   String   @map("service_id")
  countryId   String   @map("country_id")
  isAvailable Boolean  @default(false) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([serviceId, countryId])
  @@index([countryId, isAvailable, serviceId])
  @@index([serviceId, isAvailable])
  @@map("service_country_availability")
}

model ServiceMediaAssociation {
  id           String    @id @default(cuid())
  serviceId    String    @map("service_id")
  mediaFileId  String    @unique @map("media_file_id")
  displayOrder Int       @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  mediaFile    MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Restrict)

  @@unique([serviceId, displayOrder])
  @@map("service_media_associations")
}

model CatalogCommandRequest {
  id                  String               @id @default(cuid())
  actorUserId         String               @map("actor_user_id")
  scopeKey            String               @map("scope_key") @db.VarChar(200)
  idempotencyKey      String               @map("idempotency_key") @db.VarChar(200)
  requestHash         String               @map("request_hash") @db.VarChar(64)
  status              CatalogCommandStatus
  targetType          String               @map("target_type") @db.VarChar(80)
  targetId            String?              @map("target_id")
  acceptedVersion     Int?                 @map("accepted_version")
  reservedMediaFileId String?              @map("reserved_media_file_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  completedAt         DateTime?            @map("completed_at")

  @@unique([actorUserId, scopeKey, idempotencyKey])
  @@index([actorUserId, createdAt])
  @@map("catalog_command_requests")
}

// ---------------------------------------------------------------------------
// R1-P09 — Provider Services, Pricing & Historical Snapshots
// ---------------------------------------------------------------------------

enum ProviderServicePriceStatus {
  PENDING
  EFFECTIVE
  REJECTED
  SUPERSEDED
}

enum ProviderServicePriceHistoryEvent {
  PRICE_PROPOSED_PENDING
  PRICE_EFFECTIVE_IMMEDIATE
  PRICE_APPROVED
  PRICE_REJECTED
  PRICE_SUPERSEDED_PENDING
  PRICE_SUPERSEDED_EFFECTIVE
}

enum ProviderServiceStatusHistoryEvent {
  OFFERING_CREATED
  CONFIGURATION_UPDATED
  OFFERING_ENABLED
  OFFERING_DISABLED
}

model ProviderService {
  id                        String   @id @default(cuid())
  providerId                String   @map("provider_id")
  catalogServiceId          String   @map("catalog_service_id")
  enabled                   Boolean  @default(false)
  estimatedDurationMinutes  Int      @map("estimated_duration_minutes")
  noteAr                    String?  @map("note_ar") @db.VarChar(1000)
  noteEn                    String?  @map("note_en") @db.VarChar(1000)
  version                   Int      @default(1)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  provider                  Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  catalogService            Service  @relation(fields: [catalogServiceId], references: [id], onDelete: Restrict)
  prices                    ProviderServicePrice[] @relation("ProviderServicePriceOfferingProvider")
  pricesByCatalogService    ProviderServicePrice[] @relation("ProviderServicePriceOfferingCatalog")
  priceHistory              ProviderServicePriceHistory[]
  statusHistory             ProviderServiceStatusHistory[]

  @@unique([providerId, catalogServiceId])
  @@unique([id, providerId])
  @@unique([id, catalogServiceId])
  @@index([providerId, enabled, id])
  @@index([catalogServiceId, providerId])
  @@map("provider_services")
}

model ProviderServicePrice {
  id                              String                      @id @default(cuid())
  providerId                      String                      @map("provider_id")
  providerServiceId               String                      @map("provider_service_id")
  catalogServiceId                String                      @map("catalog_service_id")
  catalogPriceUnitId              String                      @map("catalog_price_unit_id")
  priceUnitCodeAtProposal         String                      @map("price_unit_code_at_proposal") @db.VarChar(64)
  countryIdAtProposal             String                      @map("country_id_at_proposal")
  countryCodeAtProposal           String                      @map("country_code_at_proposal") @db.VarChar(2)
  currencyId                      String                      @map("currency_id")
  currencyCode                    String                      @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces           Int                         @map("currency_decimal_places")
  providerPriceMinorUnits         Decimal                     @map("provider_price_minor_units") @db.Decimal(65, 0)
  minimumChargeMinorUnits         Decimal                     @map("minimum_charge_minor_units") @db.Decimal(65, 0)
  maximumPriceMinorUnitsAtProposal Decimal                    @map("maximum_price_minor_units_at_proposal") @db.Decimal(65, 0)
  approvalRequiredAtProposal      Boolean                     @map("approval_required_at_proposal")
  status                          ProviderServicePriceStatus
  proposedByUserId                String                      @map("proposed_by_user_id")
  effectiveAt                     DateTime?                   @map("effective_at")
  rejectedAt                      DateTime?                   @map("rejected_at")
  supersededAt                    DateTime?                   @map("superseded_at")
  createdAt                       DateTime                    @default(now()) @map("created_at")
  provider                        Provider                    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService                 ProviderService             @relation("ProviderServicePriceOfferingProvider", fields: [providerServiceId, providerId], references: [id, providerId], onDelete: Restrict)
  providerServiceForCatalog       ProviderService             @relation("ProviderServicePriceOfferingCatalog", fields: [providerServiceId, catalogServiceId], references: [id, catalogServiceId], onDelete: Restrict)
  catalogPriceUnit                ServicePriceUnit            @relation(fields: [catalogPriceUnitId, catalogServiceId], references: [id, serviceId], onDelete: Restrict)
  countryAtProposal               Country                     @relation("ProviderServicePriceCountryAtProposal", fields: [countryIdAtProposal], references: [id], onDelete: Restrict)
  currency                        Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  proposedBy                      User                        @relation("ProviderServicePriceProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  history                         ProviderServicePriceHistory[]

  @@unique([id, providerServiceId, providerId])
  @@index([providerServiceId, createdAt, id])
  @@index([providerId, status, createdAt, id])
  @@map("provider_service_prices")
}

model ProviderServicePriceHistory {
  id                     String                            @id @default(cuid())
  providerId             String                            @map("provider_id")
  providerServiceId      String                            @map("provider_service_id")
  providerServicePriceId String                            @map("provider_service_price_id")
  event                  ProviderServicePriceHistoryEvent
  fromStatus             ProviderServicePriceStatus?       @map("from_status")
  toStatus               ProviderServicePriceStatus        @map("to_status")
  actorUserId            String                            @map("actor_user_id")
  reasonCode             String                            @map("reason_code") @db.VarChar(100)
  reasonText             String?                           @map("reason_text") @db.VarChar(1000)
  safeBefore             Json?                             @map("safe_before")
  safeAfter              Json                              @map("safe_after")
  requestId              String                            @map("request_id") @db.VarChar(200)
  aggregateVersion       Int                               @map("aggregate_version")
  scopeKey               String?                           @map("scope_key") @db.VarChar(240)
  idempotencyKey         String?                           @map("idempotency_key") @db.VarChar(200)
  requestFingerprint     String?                           @map("request_fingerprint") @db.Char(64)
  safeResultCode         String?                           @map("safe_result_code") @db.VarChar(100)
  safeResultJson         Json?                             @map("safe_result_json")
  operationKey           String                            @unique @map("operation_key") @db.VarChar(240)
  createdAt              DateTime                          @default(now()) @map("created_at")
  provider               Provider                          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService        ProviderService                   @relation(fields: [providerServiceId, providerId], references: [id, providerId], onDelete: Restrict)
  providerServicePrice   ProviderServicePrice              @relation(fields: [providerServicePriceId, providerServiceId, providerId], references: [id, providerServiceId, providerId], onDelete: Restrict)
  actor                  User                              @relation("ProviderServicePriceHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([providerId, providerServiceId, createdAt, id])
  @@index([providerServicePriceId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@index([requestId, event])
  @@map("provider_service_price_history")
}

model ProviderServiceStatusHistory {
  id                 String                              @id @default(cuid())
  providerId         String                              @map("provider_id")
  providerServiceId  String                              @map("provider_service_id")
  event              ProviderServiceStatusHistoryEvent
  fromEnabled        Boolean?                            @map("from_enabled")
  toEnabled          Boolean                             @map("to_enabled")
  actorUserId        String                              @map("actor_user_id")
  reasonCode         String                              @map("reason_code") @db.VarChar(100)
  reasonText         String?                             @map("reason_text") @db.VarChar(1000)
  safeBefore         Json?                               @map("safe_before")
  safeAfter          Json                                @map("safe_after")
  requestId          String                              @map("request_id") @db.VarChar(200)
  aggregateVersion   Int                                 @map("aggregate_version")
  scopeKey           String                              @map("scope_key") @db.VarChar(240)
  idempotencyKey     String                              @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String                              @map("request_fingerprint") @db.Char(64)
  safeResultCode     String                              @map("safe_result_code") @db.VarChar(100)
  safeResultJson     Json                                @map("safe_result_json")
  operationKey       String                              @unique @map("operation_key") @db.VarChar(240)
  createdAt          DateTime                            @default(now()) @map("created_at")
  provider           Provider                            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService    ProviderService                     @relation(fields: [providerServiceId, providerId], references: [id, providerId], onDelete: Restrict)
  actor              User                                @relation("ProviderServiceStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, idempotencyKey])
  @@index([providerId, providerServiceId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@index([requestId, event])
  @@map("provider_service_status_history")
}

// ---------------------------------------------------------------------------
// R1-P10 — Availability, Capacity & Textual Coverage
// ---------------------------------------------------------------------------
// Configuration owns City/District localized textual hierarchy. Providers owns
// availability configuration (coverage, schedules, exceptions, capacity,
// pause) and its command receipt/history ledger. Batch A implements the
// coverage vertical; schedule/capacity/pause tables exist for later batches.

enum ProviderAvailabilityCommandStatus {
  IN_PROGRESS
  ACCEPTED
}

enum ProviderAvailabilityHistoryTargetType {
  COVERAGE
  SCHEDULE
  SCHEDULE_EXCEPTION
  WORKER_SCHEDULE
  WORKER_SCHEDULE_EXCEPTION
  CAPACITY
  PAUSE
}

enum ConfigurationLocalityCommandStatus {
  IN_PROGRESS
  ACCEPTED
}

model City {
  id            String                 @id @default(cuid())
  countryId     String                 @map("country_id")
  code          String                 @db.VarChar(40)
  nameEn        String                 @map("name_en") @db.VarChar(200)
  nameAr        String                 @map("name_ar") @db.VarChar(200)
  isActive      Boolean                @default(true) @map("is_active")
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  country       Country                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  districts     District[]
  coverageAreas ProviderCoverageArea[] @relation("ProviderCoverageAreaCity")

  @@unique([countryId, code])
  @@unique([countryId, nameEn])
  @@unique([countryId, nameAr])
  @@index([countryId, isActive, id])
  @@map("cities")
}

model District {
  id            String                 @id @default(cuid())
  cityId        String                 @map("city_id")
  code          String                 @db.VarChar(40)
  nameEn        String                 @map("name_en") @db.VarChar(200)
  nameAr        String                 @map("name_ar") @db.VarChar(200)
  isActive      Boolean                @default(true) @map("is_active")
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  city          City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  coverageAreas ProviderCoverageArea[] @relation("ProviderCoverageAreaDistrict")

  @@unique([cityId, code])
  @@unique([cityId, nameEn])
  @@unique([cityId, nameAr])
  @@index([cityId, isActive, id])
  @@map("districts")
}

model ProviderAvailabilityConfiguration {
  id         String   @id @default(cuid())
  providerId String   @unique @map("provider_id")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@map("provider_availability_configurations")
}

model ProviderCoverageArea {
  id         String    @id @default(cuid())
  providerId String    @map("provider_id")
  cityId     String?   @map("city_id")
  districtId String?   @map("district_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  city       City?     @relation("ProviderCoverageAreaCity", fields: [cityId], references: [id], onDelete: Restrict)
  district   District? @relation("ProviderCoverageAreaDistrict", fields: [districtId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([cityId])
  @@index([districtId])
  @@map("provider_coverage_areas")
}

model ProviderSchedule {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  endsNextDay Boolean  @default(false) @map("ends_next_day")
  createdAt   DateTime @default(now()) @map("created_at")
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  // R1-P10 repair: reject exact duplicate weekly periods now; overlap
  // validation beyond exact duplicates stays application-level for Batch B.
  @@unique([providerId, weekday, startMinute, endMinute, endsNextDay])
  @@index([providerId, weekday])
  @@map("provider_schedules")
}

/// R1-P10 repair (DEC-054): one civil date may carry either exactly one
/// `closed` (holiday) row or one-or-more distinct open period rows that
/// together fully replace that date's weekly hours. At-most-one-holiday and
/// no-duplicate-period are enforced by migration-only partial unique indexes
/// (`provider_schedule_exceptions_one_holiday_per_date`,
/// `provider_schedule_exceptions_no_duplicate_period`); Prisma's schema layer
/// cannot express a WHERE-qualified unique index.
model ProviderScheduleException {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  localDate   DateTime @map("local_date") @db.Date
  closed      Boolean  @default(false)
  startMinute Int?     @map("start_minute")
  endMinute   Int?     @map("end_minute")
  endsNextDay Boolean  @default(false) @map("ends_next_day")
  createdAt   DateTime @default(now()) @map("created_at")
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, localDate])
  @@map("provider_schedule_exceptions")
}

model WorkerSchedule {
  id          String         @id @default(cuid())
  workerId    String         @map("worker_id")
  weekday     Int
  startMinute Int            @map("start_minute")
  endMinute   Int            @map("end_minute")
  endsNextDay Boolean        @default(false) @map("ends_next_day")
  createdAt   DateTime       @default(now()) @map("created_at")
  worker      ProviderWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  // R1-P10 repair: reject exact duplicate weekly periods now; overlap
  // validation beyond exact duplicates stays application-level for Batch B.
  @@unique([workerId, weekday, startMinute, endMinute, endsNextDay])
  @@index([workerId, weekday])
  @@map("worker_schedules")
}

/// R1-P10 repair (DEC-054): same one-holiday-or-many-open-periods shape and
/// migration-only partial unique indexes as `ProviderScheduleException`
/// (`worker_schedule_exceptions_one_holiday_per_date`,
/// `worker_schedule_exceptions_no_duplicate_period`).
model WorkerScheduleException {
  id          String         @id @default(cuid())
  workerId    String         @map("worker_id")
  localDate   DateTime       @map("local_date") @db.Date
  closed      Boolean        @default(false)
  startMinute Int?           @map("start_minute")
  endMinute   Int?           @map("end_minute")
  endsNextDay Boolean        @default(false) @map("ends_next_day")
  createdAt   DateTime       @default(now()) @map("created_at")
  worker      ProviderWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@index([workerId, localDate])
  @@map("worker_schedule_exceptions")
}

