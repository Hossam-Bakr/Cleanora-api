// R1-P05 provider onboarding, profile, membership, invitation, gallery, and outbox.
// providers owns these tables; authentication/media/configuration keep opposite relations only.

model Provider {
  id                     String                     @id @default(cuid())
  applicationOwnerUserId String                     @unique @map("application_owner_user_id")
  ownerUserId            String?                    @unique @map("owner_user_id")
  kind                   ProviderKind
  applicationStatus      ProviderApplicationStatus  @default(DRAFT) @map("application_status")
  operationalStatus      ProviderOperationalStatus  @default(INACTIVE) @map("operational_status")
  reviewCycle            Int                        @default(0) @map("review_cycle")
  version                Int                        @default(1)
  payoutPrimaryStateVersion Int                     @default(0) @map("payout_primary_state_version")
  firstSubmittedAt       DateTime?                  @map("first_submitted_at")
  lastSubmittedAt        DateTime?                  @map("last_submitted_at")
  applicationChangedAt   DateTime                   @default(now()) @map("application_changed_at")
  operationalChangedAt   DateTime                   @default(now()) @map("operational_changed_at")
  approvedAt             DateTime?                  @map("approved_at")
  rejectedAt             DateTime?                  @map("rejected_at")
  suspendedAt            DateTime?                  @map("suspended_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  applicationOwner       User                       @relation("ProviderApplicationOwner", fields: [applicationOwnerUserId], references: [id], onDelete: Restrict)
  owner                  User?                      @relation("ProviderApprovedOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  profile                ProviderProfile?
  contact                ProviderContact?
  statusHistory          ProviderStatusHistory[]
  members                ProviderMember[]
  adminInvitations       ProviderAdminInvitation[]
  galleryItems           ProviderGalleryItem[]
  emailOutbox            ProviderEmailOutbox[]
  documentChains         ProviderDocumentChain[]
  documentVersions       ProviderDocumentVersion[]
  documentReviews        ProviderDocumentReview[]
  verificationHistory    ProviderVerificationHistory[]
  payoutDestinationChains ProviderPayoutDestinationChain[]
  payoutIdentityClaims    ProviderPayoutIdentityClaim[]
  payoutDestinationVersions ProviderPayoutDestinationVersion[]
  payoutDecisions         ProviderPayoutDecision[]
  primaryPayoutDestination ProviderPrimaryPayoutDestination?
  payoutConflicts         ProviderPayoutConflict[]
  payoutHistory           ProviderPayoutHistory[]
  workers                 ProviderWorker[]
  teams                   ProviderTeam[]
  workforceHistory        ProviderWorkforceHistory[]
  workforceCommands       ProviderWorkforceCommand[]
  workforceNotifications  ProviderWorkforceNotificationIntent[]
  workforceStateVersion   Int                        @default(1) @map("workforce_state_version")
  services                ProviderService[]
  servicePrices           ProviderServicePrice[]
  servicePriceHistory     ProviderServicePriceHistory[]
  serviceStatusHistory    ProviderServiceStatusHistory[]
  availabilityConfiguration ProviderAvailabilityConfiguration?
  coverageAreas             ProviderCoverageArea[]
  schedules                 ProviderSchedule[]
  scheduleExceptions        ProviderScheduleException[]
  capacityRule              ProviderCapacityRule?
  temporaryPauses           ProviderTemporaryPause[]
  availabilityCommands      ProviderAvailabilityCommand[]
  availabilityHistory       ProviderAvailabilityHistory[]

  @@index([applicationStatus, kind, lastSubmittedAt, id])
  @@index([operationalStatus, id])
  @@map("providers")
}

model ProviderProfile {
