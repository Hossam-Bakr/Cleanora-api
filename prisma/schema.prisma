}

// R1-P07 Provider-owned workforce, Team, command, history, and notification truth.

model ProviderWorker {
  id                         String                  @id @default(cuid())
  providerId                 String                  @map("provider_id")
  identityUserId             String?                 @map("identity_user_id")
  predecessorWorkerId        String?                 @unique @map("predecessor_worker_id")
  status                     WorkerOperationalStatus @default(DRAFT)
  version                    Int                     @default(1)
  acceptedInvitationLocale   PreferredLanguage?      @map("accepted_invitation_locale")
  endedAt                    DateTime?                @map("ended_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  provider                   Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)
  identityUser               User?                    @relation("ProviderWorkerIdentity", fields: [identityUserId], references: [id], onDelete: Restrict)
  predecessor                ProviderWorker?          @relation("ProviderWorkerPredecessor", fields: [predecessorWorkerId], references: [id], onDelete: Restrict)
  successors                 ProviderWorker[]         @relation("ProviderWorkerPredecessor")
  profile                    ProviderWorkerProfile?
  loginAccess                ProviderWorkerLoginAccess?
  invitations                ProviderWorkerInvitation[]
  skills                     ProviderWorkerSkill[]
  teamMemberships            ProviderTeamMembership[]
  supervisedTeams            ProviderTeam[]           @relation("ProviderTeamPrimarySupervisor")
  schedules                WorkerSchedule[]
  scheduleExceptions       WorkerScheduleException[]

  @@index([providerId, status, id])
  @@index([providerId, updatedAt, id])
  @@index([identityUserId, endedAt])
  @@map("provider_workers")
}

model ProviderWorkerProfile {
  workerId                 String       @id @map("worker_id")
  fullLegalName            String       @map("full_legal_name") @db.VarChar(200)
  gender                   WorkerGender
  operationalPhoneE164     String       @map("operational_phone_e164") @db.VarChar(16)
  workerType               WorkerType   @map("worker_type")
  displayTitle             String?      @map("display_title") @db.VarChar(120)
  supervisorCapable        Boolean      @default(false) @map("supervisor_capable")
  avatarMediaFileId        String?      @unique @map("avatar_media_file_id")
  version                  Int          @default(1)
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  worker                   ProviderWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  avatarMediaFile          MediaFile?   @relation("ProviderWorkerProfileAvatar", fields: [avatarMediaFileId], references: [id], onDelete: Restrict)

  @@index([workerType, supervisorCapable])
  @@map("provider_worker_profiles")
}

model ProviderWorkerSkill {
  id              String   @id @default(cuid())
  workerId        String   @map("worker_id")
  displayLabel    String   @map("display_label") @db.VarChar(100)
  normalizedLabel String   @map("normalized_label") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  worker          ProviderWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([workerId, normalizedLabel])
  @@map("provider_worker_skills")
}

model ProviderWorkerLoginAccess {
  workerId             String                  @id @map("worker_id")
  status               WorkerLoginAccessStatus
  version              Int                     @default(1)
  currentInvitationId  String?                 @unique @map("current_invitation_id")
  activatedAt          DateTime?               @map("activated_at")
  revokedAt            DateTime?               @map("revoked_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  worker               ProviderWorker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  currentInvitation    ProviderWorkerInvitation? @relation("ProviderWorkerCurrentInvitation", fields: [currentInvitationId], references: [id], onDelete: Restrict)

  @@map("provider_worker_login_access")
}

model ProviderWorkerInvitation {
  id                String                   @id @default(cuid())
  workerId          String                   @map("worker_id")
  invitationVersion Int                      @map("invitation_version")
  emailNormalized   String                   @map("email_normalized") @db.VarChar(320)
  locale            PreferredLanguage
  status            WorkerInvitationStatus   @default(PENDING)
  version           Int                      @default(1)
  issuedByUserId    String                   @map("issued_by_user_id")
  acceptedByUserId  String?                  @map("accepted_by_user_id")
  issuedAt          DateTime                 @default(now()) @map("issued_at")
  expiresAt         DateTime                 @map("expires_at")
  acceptedAt        DateTime?                @map("accepted_at")
  revokedAt         DateTime?                @map("revoked_at")
  expiredAt         DateTime?                @map("expired_at")
  supersededAt      DateTime?                @map("superseded_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  worker            ProviderWorker           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  issuedByUser      User                     @relation("ProviderWorkerInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  acceptedByUser    User?                    @relation("ProviderWorkerInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  currentForAccess  ProviderWorkerLoginAccess? @relation("ProviderWorkerCurrentInvitation")
  notificationIntents ProviderWorkforceNotificationIntent[]

  @@unique([workerId, invitationVersion])
  @@index([workerId, status, invitationVersion])
  @@index([status, expiresAt])
  @@map("provider_worker_invitations")
}

model ProviderTeam {
  id                         String             @id @default(cuid())
  providerId                 String             @map("provider_id")
  name                       String?            @db.VarChar(200)
  normalizedName             String?            @map("normalized_name") @db.VarChar(200)
  status                     ProviderTeamStatus @default(DRAFT)
  primarySupervisorWorkerId  String?            @map("primary_supervisor_worker_id")
  version                    Int                @default(1)
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  provider                   Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  primarySupervisor          ProviderWorker?    @relation("ProviderTeamPrimarySupervisor", fields: [primarySupervisorWorkerId], references: [id], onDelete: Restrict)
  memberships                ProviderTeamMembership[]

  @@index([providerId, status, id])
  @@map("provider_teams")
}

model ProviderTeamMembership {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  workerId    String   @map("worker_id")
  cleans      Boolean  @default(false)
  version     Int      @default(1)
  startedAt   DateTime @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  team        ProviderTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  worker      ProviderWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([teamId, workerId, startedAt])
  @@index([teamId, endedAt, id])
  @@map("provider_team_memberships")
}

model ProviderWorkforceHistory {
  id            String                         @id @default(cuid())
  providerId    String                         @map("provider_id")
  targetType    ProviderWorkforceTargetType    @map("target_type")
  targetId      String                         @map("target_id")
  targetVersion Int                            @map("target_version")
