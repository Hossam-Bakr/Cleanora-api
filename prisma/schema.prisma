  logoMediaFile     MediaFile? @relation("ProviderProfileLogo", fields: [logoMediaFileId], references: [id], onDelete: Restrict)
  coverMediaFile    MediaFile? @relation("ProviderProfileCover", fields: [coverMediaFileId], references: [id], onDelete: Restrict)

