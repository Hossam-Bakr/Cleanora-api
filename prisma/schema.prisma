// ---------------------------------------------------------------------------
// R1-P17 — Worker & Team Assignment
// ---------------------------------------------------------------------------

enum BookingAssignmentStatus {
  ACTIVE
  SUPERSEDED
}

enum BookingAssignmentSource {
  TEAM
  WORKERS
}

enum BookingAssignmentHistoryEvent {
  CREATED
  REPLACED
  SUPERSEDED
}

model BookingAssignment {
  id               String                   @id @default(cuid())
  bookingId        String                   @map("booking_id")
  providerId       String                   @map("provider_id")
  status           BookingAssignmentStatus
  source           BookingAssignmentSource
  teamId           String?                  @map("team_id")
  teamVersion      Int?                     @map("team_version")
  startsAt         DateTime                 @map("starts_at")
  endsAt           DateTime                 @map("ends_at")
  assignedByUserId String                   @map("assigned_by_user_id")
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  supersededAt     DateTime?                @map("superseded_at")
  booking          Booking                  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  assignedBy       User                     @relation("BookingAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  members          BookingAssignmentMember[]
  history          BookingAssignmentHistory[]

  @@index([bookingId, status])
  @@index([providerId, status, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@map("booking_assignments")
}

model BookingAssignmentMember {
  id            String            @id @default(cuid())
  assignmentId  String            @map("assignment_id")
  workerId      String            @map("worker_id")
  workerUserId  String?           @map("worker_user_id")
  workerType    String            @map("worker_type") @db.VarChar(40)
  gender        String            @db.VarChar(40)
  cleans        Boolean
  displayNameEn String            @map("display_name_en") @db.VarChar(200)
  displayNameAr String            @map("display_name_ar") @db.VarChar(200)
  sortOrder     Int               @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  assignment    BookingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, workerId])
  @@index([workerId, assignmentId])
  @@index([workerUserId, assignmentId])
  @@map("booking_assignment_members")
}

model BookingAssignmentHistory {
  id             String                         @id @default(cuid())
  bookingId      String                         @map("booking_id")
  assignmentId   String                         @map("assignment_id")
  event          BookingAssignmentHistoryEvent
  actorUserId    String                         @map("actor_user_id")
  reasonCode     String                         @map("reason_code") @db.VarChar(100)
  reasonText     String?                        @map("reason_text") @db.VarChar(1000)
  safeBefore     Json?                          @map("safe_before")
  safeAfter      Json                           @map("safe_after")
  requestId      String                         @map("request_id") @db.VarChar(200)
  operationKey   String                         @unique @map("operation_key") @db.VarChar(240)
  createdAt      DateTime                       @default(now()) @map("created_at")
  booking        Booking                        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  assignment     BookingAssignment              @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actor          User                           @relation("BookingAssignmentHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([assignmentId, createdAt])
  @@map("booking_assignment_history")
}

enum LedgerAccountType {
  PLATFORM_CLEARING
  PLATFORM_REVENUE
  PROVIDER_PAYABLE
  CUSTOMER_DEPOSIT_LIABILITY
  COD_CLEARING
  PAYOUT_CLEARING
  REFUND_CLEARING
  ADJUSTMENT_CLEARING
}

enum LedgerEntryType {
  DEPOSIT
  PLATFORM_FEE
  PROVIDER_SHARE
  MARKETER_COMMISSION
  COD_REMAINING
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum LedgerLinkKind {
  BOOKING
  ORDER
}

enum LedgerCommandType {
  POST_JOURNAL
  POST_ADJUSTMENT
  CREATE_SNAPSHOT
}

enum LedgerActorKind {
  SYSTEM
  TEST
  STAFF_FINANCE
}

enum LedgerSnapshotSubjectKind {
  ACCOUNT
  BOOKING
}

model LedgerAccount {
  id                     String            @id @default(cuid())
  countryId              String            @map("country_id")
  currencyCode           String            @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces  Int               @map("currency_decimal_places")
  accountType            LedgerAccountType @map("account_type")
  createdAt              DateTime          @default(now()) @map("created_at")
  country                Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  entries                LedgerEntry[]
  snapshots              FinancialSnapshot[]

  @@unique([countryId, currencyCode, accountType])
  @@index([countryId, accountType])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id                    String          @id @default(cuid())
  journalId             String          @map("journal_id")
  accountId             String          @map("account_id")
  entryType             LedgerEntryType @map("entry_type")
  side                  LedgerEntrySide
  amountMinorUnits      Decimal         @map("amount_minor_units") @db.Decimal(65, 0)
  currencyCode          String          @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces Int             @map("currency_decimal_places")
  createdAt             DateTime        @default(now()) @map("created_at")
  account               LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  links                 LedgerEntryLink[]

  @@index([journalId])
  @@index([accountId, createdAt])
  @@index([entryType, createdAt])
  @@map("ledger_entries")
}

model LedgerEntryLink {
  id        String         @id @default(cuid())
  journalId String         @map("journal_id")
  entryId   String?        @map("entry_id")
  kind      LedgerLinkKind
  bookingId String?        @map("booking_id")
  createdAt DateTime       @default(now()) @map("created_at")
  entry     LedgerEntry?   @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([journalId, kind, bookingId])
  @@index([bookingId])
  @@map("ledger_entry_links")
}

model FinancialIdempotencyKey {
  id             String            @id @default(cuid())
  commandType    LedgerCommandType @map("command_type")
  actorKind      LedgerActorKind   @map("actor_kind")
  actorId        String            @map("actor_id")
  idempotencyKey String            @map("idempotency_key")
  payloadHash    String            @map("payload_hash")
  journalId      String?           @map("journal_id")
  snapshotId     String?           @map("snapshot_id")
  adjustmentId   String?           @map("adjustment_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([commandType, actorKind, actorId, idempotencyKey])
  @@map("financial_idempotency_keys")
}

model FinancialSnapshot {
  id                      String                    @id @default(cuid())
  subjectKind             LedgerSnapshotSubjectKind @map("subject_kind")
  accountId               String?                   @map("account_id")
  bookingId               String?                   @map("booking_id")
  currencyCode            String                    @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces   Int                       @map("currency_decimal_places")
  debitMinorUnits         Decimal                   @map("debit_minor_units") @db.Decimal(65, 0)
  creditNetMinorUnits     Decimal                   @map("credit_net_minor_units") @db.Decimal(65, 0)
  derivedBalanceMinorUnits Decimal                  @map("derived_balance_minor_units") @db.Decimal(65, 0)
  entryIdHash             String                    @map("entry_id_hash")
  createdAt               DateTime                  @default(now()) @map("created_at")
  account                 LedgerAccount?            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("financial_snapshots")
}

model FinancialAdjustment {
  id                 String          @id @default(cuid())
  actorKind          LedgerActorKind @map("actor_kind")
  actorId            String          @map("actor_id")
  reason             String          @db.VarChar(500)
  originalJournalId  String          @map("original_journal_id")
  reversingJournalId String          @map("reversing_journal_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([originalJournalId])
  @@map("financial_adjustments")
}

enum PaymentRailProvider {
  PAYMOB
  OTHER_DISABLED
}

enum PaymentMethodKind {
  CARD
  WALLET
  OTHER
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  BOOKING_DEPOSIT
}

enum PaymentGatewayEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REJECTED
}

enum RefundRequestStatus {
  REQUESTED
}

model PaymentMethod {
  id            String              @id @default(cuid())
  countryId     String              @map("country_id")
  provider      PaymentRailProvider
  methodKind    PaymentMethodKind   @map("method_kind")
  code          String
  displayNameAr String              @map("display_name_ar")
  displayNameEn String              @map("display_name_en")
  enabled       Boolean             @default(false)
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  country       Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  attempts      PaymentAttempt[]
  payments      Payment[]

  @@unique([countryId, code])
  @@unique([countryId, provider, methodKind])
  @@index([countryId, enabled])
  @@map("payment_methods")
}

model Payment {
  id                    String           @id @default(cuid())
  bookingId             String           @map("booking_id")
  customerUserId        String           @map("customer_user_id")
  purpose               PaymentPurpose
  status                PaymentStatus
  amountMinorUnits      Decimal          @map("amount_minor_units") @db.Decimal(65, 0)
  currencyCode          String           @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces Int              @map("currency_decimal_places")
  paymentMethodId       String           @map("payment_method_id")
  succeededAttemptId    String?          @unique @map("succeeded_attempt_id")
  ledgerJournalId       String?          @map("ledger_journal_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  paymentMethod         PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  succeededAttempt      PaymentAttempt?  @relation("PaymentSucceededAttempt", fields: [succeededAttemptId], references: [id], onDelete: Restrict)
  attempts              PaymentAttempt[] @relation("PaymentAttempts")
  gatewayEvents         PaymentGatewayEvent[]
  receipt               PaymentReceipt?
  refundRequests        RefundRequest[]

  @@index([bookingId, purpose, status])
  @@index([customerUserId, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  paymentId             String               @map("payment_id")
  bookingId             String               @map("booking_id")
  customerUserId        String               @map("customer_user_id")
  paymentMethodId       String               @map("payment_method_id")
  status                PaymentAttemptStatus
  amountMinorUnits      Decimal              @map("amount_minor_units") @db.Decimal(65, 0)
  currencyCode          String               @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces Int                  @map("currency_decimal_places")
  idempotencyKey        String               @map("idempotency_key")
  gatewaySessionRef     String?              @map("gateway_session_ref")
  redirectUrl           String?              @map("redirect_url")
  failureCode           String?              @map("failure_code")
  failureMessageSafe    String?              @map("failure_message_safe")
  expiresAt             DateTime?            @map("expires_at")
  returnTokenHash       String?              @map("return_token_hash")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  payment               Payment              @relation("PaymentAttempts", fields: [paymentId], references: [id], onDelete: Restrict)
  paymentMethod         PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  succeededPayment      Payment?             @relation("PaymentSucceededAttempt")
  gatewayEvents         PaymentGatewayEvent[]

  @@unique([customerUserId, bookingId, idempotencyKey])
  @@index([bookingId, status])
  @@index([gatewaySessionRef])
  @@map("payment_attempts")
}

model PaymentGatewayEvent {
  id               String                    @id @default(cuid())
  provider         PaymentRailProvider
  idempotencyKey   String                    @map("idempotency_key")
  paymentAttemptId String?                   @map("payment_attempt_id")
  paymentId        String?                   @map("payment_id")
  eventType        String                    @map("event_type")
  signatureValid   Boolean                   @map("signature_valid")
  status           PaymentGatewayEventStatus
  payloadHash      String                    @map("payload_hash")
  rawPayloadStored Boolean                   @default(false) @map("raw_payload_stored")
  processedAt      DateTime?                 @map("processed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  paymentAttempt   PaymentAttempt?           @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  payment          Payment?                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, idempotencyKey])
  @@index([paymentId])
  @@index([paymentAttemptId])
  @@map("payment_gateway_events")
}

model PaymentReceipt {
  id                    String   @id @default(cuid())
  paymentId             String   @unique @map("payment_id")
  bookingId             String   @map("booking_id")
  customerUserId        String   @map("customer_user_id")
  amountMinorUnits      Decimal  @map("amount_minor_units") @db.Decimal(65, 0)
  currencyCode          String   @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces Int      @map("currency_decimal_places")
  methodCode            String   @map("method_code")
  providerRef           String?  @map("provider_ref")
  issuedAt              DateTime @map("issued_at")
  createdAt             DateTime @default(now()) @map("created_at")
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([customerUserId, issuedAt])
  @@map("payment_receipts")
}

model RefundRequest {
  id                   String              @id @default(cuid())
  paymentId            String              @map("payment_id")
  bookingId            String              @map("booking_id")
  customerUserId       String              @map("customer_user_id")
  amountMinorUnits     Decimal             @map("amount_minor_units") @db.Decimal(65, 0)
  currencyCode         String              @map("currency_code") @db.VarChar(3)
  currencyDecimalPlaces Int                @map("currency_decimal_places")
  status               RefundRequestStatus
  reason               String?
  requestedByActorKind String              @map("requested_by_actor_kind")
  requestedByActorId   String              @map("requested_by_actor_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  payment              Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refund_requests")
}
