model Currency {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(3)
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  decimalPlaces Int       @map("decimal_places")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  countries     Country[] @relation("CountryDefaultCurrency")
  providerServicePrices ProviderServicePrice[]

  @@index([isActive])
  @@map("currencies")
}

model Country {
  id                String          @id @default(cuid())
  code              String          @unique @db.VarChar(2)
  nameEn            String          @map("name_en")
  nameAr            String          @map("name_ar")
  defaultCurrencyId String          @map("default_currency_id")
  defaultLocale     String          @map("default_locale")
  supportedLocales  Json            @map("supported_locales")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  defaultCurrency   Currency          @relation("CountryDefaultCurrency", fields: [defaultCurrencyId], references: [id], onDelete: Restrict)
  countryConfigs    CountryConfig[]
  cities                          City[]
  userAddresses     UserAddress[]
  providerProfiles  ProviderProfile[]
  verificationDocumentPolicies VerificationDocumentPolicyVersion[]
  payoutOperators              PayoutOperator[]
  payoutBanks                  PayoutBank[]
  payoutCountryPolicies        PayoutCountryPolicy[]
  payoutDestinationVersions    ProviderPayoutDestinationVersion[]
  serviceCountryAvailability   ServiceCountryAvailability[]
  providerServicePricesAtProposal ProviderServicePrice[] @relation("ProviderServicePriceCountryAtProposal")
  eligibilityRuleVersions      EligibilityRuleVersion[]
  bookings                     Booking[]
  ledgerAccounts               LedgerAccount[]
  paymentMethods               PaymentMethod[]

  @@index([isActive])
  @@index([defaultCurrencyId])
  @@map("countries")
}

model AppConfig {
  id               String                 @id @default(cuid())
  key              String                 @unique
  value            Json?
  valueKind        ConfigValueKind        @map("value_kind")
  resolutionPolicy ConfigResolutionPolicy @map("resolution_policy")
  description      String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@map("app_configs")
}

model CountryConfig {
  id        String          @id @default(cuid())
  countryId String          @map("country_id")
  key       String
  value     Json
  valueKind ConfigValueKind @map("value_kind")
  /// Added R1-P10 (DEC-053): optimistic-concurrency version for Staff-managed
  /// country configuration values such as `platform.default_timezone`.
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, key])
  @@index([key])
  @@map("country_configs")
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  reason     String?
  context    Json?
  requestId  String?        @map("request_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@map("audit_logs")
}

model User {
  id                               String               @id @default(cuid())
  phoneE164                        String?              @unique @map("phone_e164") @db.VarChar(16)
  emailNormalized                  String?              @unique @map("email_normalized") @db.VarChar(320)
  accountCategories                AccountCategory[]    @default([]) @map("account_categories")
  verifiedCategories               AccountCategory[]    @default([]) @map("verified_categories")
  status                           UserStatus           @default(ACTIVE)
  suspendedUntil                   DateTime?            @map("suspended_until")
  statusChangedAt                  DateTime             @default(now()) @map("status_changed_at")
  phoneVerifiedAt                  DateTime?            @map("phone_verified_at")
  emailVerifiedAt                  DateTime?            @map("email_verified_at")
  createdAt                        DateTime             @default(now()) @map("created_at")
  updatedAt                        DateTime             @updatedAt @map("updated_at")
  credential                       UserCredential?
  sessions                         UserSession[]
  otpCodes                         OtpCode[]
  passwordResets                   PasswordResetToken[]
  socialAccounts                   SocialAccount[]
  authEvents                       AuthEvent[]
  userRoles                        UserRole[]
  customerProfile                  CustomerProfile?
  individualProfile                IndividualProfile?
  companyProfile                   CompanyProfile?
  engineerProfile                  EngineerProfile?
  userPreferences                  UserPreferences?
  userAddresses                    UserAddress[]
  privacyRequests                  PrivacyRequest[]
  ownedMediaFiles                  MediaFile[]
  providerApplications             Provider[]                 @relation("ProviderApplicationOwner")
  ownedProviders                   Provider[]                 @relation("ProviderApprovedOwner")
  providerMemberships              ProviderMember[]           @relation("ProviderMemberUser")
  providerMemberInvitesSent        ProviderMember[]           @relation("ProviderMemberInviter")
  providerStatusHistoryActions     ProviderStatusHistory[]    @relation("ProviderStatusHistoryActor")
  providerAdminInvitationsSent     ProviderAdminInvitation[]  @relation("ProviderAdminInvitationInviter")
  providerAdminInvitationsAccepted ProviderAdminInvitation[]  @relation("ProviderAdminInvitationAccepter")
  providerGalleryItemsCreated      ProviderGalleryItem[]      @relation("ProviderGalleryItemCreator")
  providerEmailOutboxRecipients    ProviderEmailOutbox[]      @relation("ProviderEmailOutboxRecipient")
  workerEngagements                ProviderWorker[]            @relation("ProviderWorkerIdentity")
  workerInvitationsIssued          ProviderWorkerInvitation[]  @relation("ProviderWorkerInvitationIssuer")
  workerInvitationsAccepted        ProviderWorkerInvitation[]  @relation("ProviderWorkerInvitationAccepter")
  workforceHistoryActions          ProviderWorkforceHistory[]  @relation("ProviderWorkforceHistoryActor")
  workforceCommands                ProviderWorkforceCommand[]  @relation("ProviderWorkforceCommandActor")
  workforceNotificationRecipients  ProviderWorkforceNotificationIntent[] @relation("ProviderWorkforceNotificationRecipient")
  providerServicePricesProposed   ProviderServicePrice[]                 @relation("ProviderServicePriceProposer")
  providerServicePriceHistoryActions ProviderServicePriceHistory[]       @relation("ProviderServicePriceHistoryActor")
  providerServiceStatusHistoryActions ProviderServiceStatusHistory[]     @relation("ProviderServiceStatusHistoryActor")
  availabilityCommandActions          ProviderAvailabilityCommand[]         @relation("ProviderAvailabilityCommandActor")
  availabilityHistoryActions          ProviderAvailabilityHistory[]         @relation("ProviderAvailabilityHistoryActor")
  temporaryPauseActions               ProviderTemporaryPause[]              @relation("ProviderTemporaryPauseActor")
  configurationLocalityCommandActions ConfigurationLocalityCommand[]        @relation("ConfigurationLocalityCommandActor")
  customerBookings                    Booking[]                             @relation("BookingCustomer")
  bookingCommands                     BookingCommand[]                      @relation("BookingCommandCustomer")
  bookingStatusHistoryActions         BookingStatusHistory[]                @relation("BookingStatusHistoryActor")
  bookingResponseDecisions            BookingResponse[]                     @relation("BookingResponseDecider")
  bookingCancellations                BookingCancellation[]                 @relation("BookingCancellationActor")
  bookingNotificationRecipients       BookingNotificationIntent[]           @relation("BookingNotificationRecipient")
  bookingActorCommands                BookingActorCommand[]                 @relation("BookingActorCommandActor")
  bookingAssignmentActors             BookingAssignment[]                   @relation("BookingAssignmentActor")
  bookingAssignmentHistoryActors      BookingAssignmentHistory[]            @relation("BookingAssignmentHistoryActor")

  @@index([status])
  @@map("users")
}

model UserCredential {
  id                     String    @id @default(cuid())
  userId                 String    @unique @map("user_id")
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  passwordHashVersion    Int       @default(1) @map("password_hash_version")
  credentialVersion      Int       @default(1) @map("credential_version")
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failureWindowStartedAt DateTime? @map("failure_window_started_at")
  lockedUntil            DateTime? @map("locked_until")
  lastFailedAt           DateTime? @map("last_failed_at")
  lastAuthenticatedAt    DateTime? @map("last_authenticated_at")
  passwordChangedAt      DateTime  @default(now()) @map("password_changed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model UserSession {
  id                     String                   @id @default(cuid())
  userId                 String                   @map("user_id")
  currentRefreshVerifier String                   @unique @map("current_refresh_verifier") @db.Char(64)
  verifierKeyVersion     Int                      @default(1) @map("verifier_key_version")
  rotationCounter        Int                      @default(0) @map("rotation_counter")
  credentialVersion      Int                      @map("credential_version")
  authenticationMethod   AuthenticationMethod     @map("authentication_method")
  capability             SessionCapability
  expiresAt              DateTime                 @map("expires_at")
  lastUsedAt             DateTime?                @map("last_used_at")
  revokedAt              DateTime?                @map("revoked_at")
  revocationReason       SessionRevocationReason? @map("revocation_reason")
  compromisedAt          DateTime?                @map("compromised_at")
  ipHash                 String?                  @map("ip_hash") @db.Char(64)
  userAgentHash          String?                  @map("user_agent_hash") @db.Char(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  sensitiveActionProofUses SensitiveActionProofUse[]

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model SensitiveActionProofUse {
  id                   String   @id @default(cuid())
  proofIdHash          String   @unique @map("proof_id_hash") @db.Char(64)
  actorUserId          String   @map("actor_user_id")
  sessionId            String   @map("session_id")
  purpose              String   @db.VarChar(100)
  providerId           String   @map("provider_id")
  destinationVersionId String   @map("destination_version_id")
  requestId            String   @map("request_id") @db.VarChar(200)
  authenticatedAt      DateTime @map("authenticated_at")
  consumedAt           DateTime @default(now()) @map("consumed_at")
  session              UserSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([actorUserId, consumedAt])
  @@index([destinationVersionId, consumedAt])
  @@map("sensitive_action_proof_uses")
}

model OtpCode {
  id                 String              @id @default(cuid())
  userId             String              @map("user_id")
  accountCategory    AccountCategory?    @map("account_category")
  purpose            OtpPurpose
  channel            AuthDeliveryChannel
  destinationHash    String              @map("destination_hash") @db.Char(64)
  codeVerifier       String              @map("code_verifier") @db.Char(64)
  verifierKeyVersion Int                 @default(1) @map("verifier_key_version")
  status             AuthChallengeStatus @default(PENDING_DELIVERY)
  attemptCount       Int                 @default(0) @map("attempt_count")
  maxAttempts        Int                 @default(5) @map("max_attempts")
  resendAvailableAt  DateTime            @map("resend_available_at")
  expiresAt          DateTime            @map("expires_at")
  deliveredAt        DateTime?           @map("delivered_at")
  deliveryFailedAt   DateTime?           @map("delivery_failed_at")
  lastAttemptAt      DateTime?           @map("last_attempt_at")
  consumedAt         DateTime?           @map("consumed_at")
  supersededAt       DateTime?           @map("superseded_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([userId, purpose, accountCategory, status])
  @@index([status, expiresAt])
  @@map("otp_codes")
}

model PasswordResetToken {
  id                 String               @id @default(cuid())
  userId             String               @map("user_id")
  purpose            PasswordResetPurpose @default(PASSWORD_RESET)
  channel            AuthDeliveryChannel
  destinationHash    String               @map("destination_hash") @db.Char(64)
  tokenVerifier      String               @unique @map("token_verifier") @db.Char(64)
  verifierKeyVersion Int                  @default(1) @map("verifier_key_version")
  status             AuthChallengeStatus  @default(PENDING_DELIVERY)
  attemptCount       Int                  @default(0) @map("attempt_count")
  maxAttempts        Int                  @default(5) @map("max_attempts")
  resendAvailableAt  DateTime             @map("resend_available_at")
  expiresAt          DateTime             @map("expires_at")
  deliveredAt        DateTime?            @map("delivered_at")
  deliveryFailedAt   DateTime?            @map("delivery_failed_at")
  lastAttemptAt      DateTime?            @map("last_attempt_at")
  consumedAt         DateTime?            @map("consumed_at")
  supersededAt       DateTime?            @map("superseded_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("password_reset_tokens")
}

model SocialAccount {
  id                      String          @id @default(cuid())
  userId                  String          @map("user_id")
  provider                SocialProvider
  accountCategory         AccountCategory @map("account_category")
  providerSubject         String          @map("provider_subject") @db.VarChar(255)
  providerEmailNormalized String?         @map("provider_email_normalized") @db.VarChar(320)
  providerEmailVerifiedAt DateTime?       @map("provider_email_verified_at")
  providerDisplayName     String?         @map("provider_display_name") @db.VarChar(200)
  providerAvatarUrl       String?         @map("provider_avatar_url") @db.VarChar(2048)
  linkedAt                DateTime        @default(now()) @map("linked_at")
  lastAuthenticatedAt     DateTime?       @map("last_authenticated_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  user                    User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider, accountCategory])
  @@index([userId])
  @@map("social_accounts")
}

model AuthEvent {
  id             String           @id @default(cuid())
  userId         String?          @map("user_id")
  sessionId      String?          @map("session_id")
  eventType      String           @map("event_type") @db.VarChar(64)
  outcome        AuthEventOutcome
  reasonCode     String?          @map("reason_code") @db.VarChar(64)
  requestId      String?          @map("request_id")
  identifierHash String?          @map("identifier_hash") @db.Char(64)
  ipHash         String?          @map("ip_hash") @db.Char(64)
  userAgentHash  String?          @map("user_agent_hash") @db.Char(64)
  context        Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([sessionId])
  @@map("auth_events")
}

// R1-P03 authorization definitions. Identity owns these five tables.
// Role and permission definitions have no activation flag; only user_roles.status
// and privileged_action_reasons.is_active carry lifecycle state.

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  roleId     String         @map("role_id")
  status     UserRoleStatus
  assignedAt DateTime       @default(now()) @map("assigned_at")
  enabledAt  DateTime?      @map("enabled_at")
  disabledAt DateTime?      @map("disabled_at")
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId])
  @@map("user_roles")
}

model PrivilegedActionReason {
