// ---------------------------------------------------------------------------
// R1-P08 — Catalog, Localization & Service Requirements
// ---------------------------------------------------------------------------

enum CatalogLocale {
  AR
  EN
}

enum ServiceFieldKind {
  INFORMATION
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
}

enum ServiceNumberMode {
  INTEGER
  DECIMAL
}

enum CatalogCommandStatus {
  PENDING
  COMPLETED
}

model ServiceCategory {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(80)
  nameAr         String?   @map("name_ar") @db.VarChar(160)
  nameEn         String?   @map("name_en") @db.VarChar(160)
  descriptionAr  String?   @map("description_ar") @db.VarChar(2000)
  descriptionEn  String?   @map("description_en") @db.VarChar(2000)
  displayOrder   Int       @unique @map("display_order")
  isActive       Boolean   @default(false) @map("is_active")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  services       Service[]

  @@map("service_categories")
}

model Service {
  id              String                       @id @default(cuid())
  categoryId      String                       @map("category_id")
  code            String                       @unique @db.VarChar(100)
  displayOrder    Int                          @map("display_order")
  isActive        Boolean                      @default(false) @map("is_active")
  version         Int                          @default(1)
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  category        ServiceCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations    ServiceTranslation[]
  priceUnits      ServicePriceUnit[]
  fields          ServiceField[]
  countryRows     ServiceCountryAvailability[]
  mediaAssociations ServiceMediaAssociation[]
  providerServices ProviderService[]

  @@unique([categoryId, displayOrder])
  @@index([categoryId, isActive, displayOrder])
  @@map("services")
}

model ServiceTranslation {
  id          String        @id @default(cuid())
  serviceId   String        @map("service_id")
  locale      CatalogLocale
  name        String?       @db.VarChar(160)
  description String?       @db.VarChar(2000)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, locale])
  @@map("service_translations")
}

model ServicePriceUnit {
  id           String   @id @default(cuid())
  serviceId    String   @map("service_id")
  code         String   @db.VarChar(64)
  labelAr      String?  @map("label_ar") @db.VarChar(120)
  labelEn      String?  @map("label_en") @db.VarChar(120)
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  providerServicePrices ProviderServicePrice[]

  @@unique([serviceId, code])
  @@unique([serviceId, displayOrder])
  @@unique([id, serviceId])
  @@map("service_price_units")
}

model ServiceField {
  id             String              @id @default(cuid())
  serviceId      String              @map("service_id")
  code           String              @db.VarChar(80)
  kind           ServiceFieldKind
  labelAr        String?             @map("label_ar") @db.VarChar(300)
  labelEn        String?             @map("label_en") @db.VarChar(300)
  helpTextAr     String?             @map("help_text_ar") @db.VarChar(1000)
  helpTextEn     String?             @map("help_text_en") @db.VarChar(1000)
  isRequired     Boolean             @default(false) @map("is_required")
  minLength      Int?                @map("min_length")
  maxLength      Int?                @map("max_length")
  numberMode     ServiceNumberMode?  @map("number_mode")
  minValue       Decimal?            @map("min_value") @db.Decimal(18, 3)
  maxValue       Decimal?            @map("max_value") @db.Decimal(18, 3)
  minSelections  Int?                @map("min_selections")
  maxSelections  Int?                @map("max_selections")
  displayOrder   Int                 @map("display_order")
  isActive       Boolean             @default(false) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  options        ServiceFieldOption[]

  @@unique([serviceId, code])
  @@unique([serviceId, displayOrder])
  @@map("service_fields")
}

model ServiceFieldOption {
  id             String      @id @default(cuid())
  serviceFieldId String      @map("service_field_id")
  value          String      @db.VarChar(80)
  labelAr        String?     @map("label_ar") @db.VarChar(200)
  labelEn        String?     @map("label_en") @db.VarChar(200)
